# Neon/Postgres integration.
# Both vars point at the same Neon project (main stats DB).
# DATABASE_URL  — used by direct dbQuery calls (players, stats, audit, etc.)
# AUTH_DATABASE_URL — used by @ndsc/auth for users/sessions (same DB, different var name)
DATABASE_URL="postgresql://user:password@host-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
AUTH_DATABASE_URL="postgresql://user:password@host-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Admin login uses the users table, user_sessions table, and role=admin/owner.
# Resend is used by the member password reset flow and observed in admin email health.
RESEND_API_KEY="re_xxxxxxxxx"
PASSWORD_RESET_FROM_EMAIL="North Down Softball Club <no-reply@northdownsoftballclub.co.uk>"

# Public site URL used by member-facing flows in the app that owns password reset.
NEXT_PUBLIC_SITE_URL="https://northdownsoftballclub.co.uk"
